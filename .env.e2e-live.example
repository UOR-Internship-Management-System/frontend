# Copy this file to .env.e2e-live.local. The *.local file is ignored by Git.
# The backend must already be running against an isolated/local PostgreSQL database.
CV_E2E_BACKEND_ORIGIN=http://127.0.0.1:8080
CV_E2E_ADMIN_EMAIL=admin@dcs.ruh.ac.lk
CV_E2E_ADMIN_PASSWORD=replace-with-your-local-admin-password
